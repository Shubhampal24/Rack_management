# Backend Environment Variables
# Copy this to .env and fill in your values

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/rackos?retryWrites=true&w=majority

# JWT Secret - change this to a long random string in production
JWT_SECRET=rackos_super_secret_jwt_key_2024_change_me

# JWT Expiry
JWT_EXPIRES_IN=7d

# Server Port
PORT=5001

# CORS allowed origin (your frontend dev server)
ALLOWED_ORIGIN=http://localhost:5173
